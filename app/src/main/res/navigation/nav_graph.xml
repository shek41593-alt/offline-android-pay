<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.lastmilebanking.app.features.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splash_to_landing"
            app:destination="@id/landingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/landingFragment"
        android:name="com.lastmilebanking.app.features.onboarding.LandingFragment"
        android:label="Landing"
        tools:layout="@layout/fragment_landing" >
        <action
            android:id="@+id/action_landing_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_landing_to_authChoice"
            app:destination="@id/authChoiceFragment" />
        <action
            android:id="@+id/action_landing_to_onboarding"
            app:destination="@id/onboardingFragment" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.lastmilebanking.app.features.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding" >
        <action
            android:id="@+id/action_onboarding_to_create_account"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/authChoiceFragment"
        android:name="com.lastmilebanking.app.features.onboarding.AuthChoiceFragment"
        android:label="Auth Choice"
        tools:layout="@layout/fragment_auth_choice" >
        <action
            android:id="@+id/action_authChoice_to_login"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.lastmilebanking.app.features.authentication.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_login_to_otp"
            app:destination="@id/otpFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/otpFragment"
        android:name="com.lastmilebanking.app.features.authentication.OTPFragment"
        android:label="OTP"
        tools:layout="@layout/fragment_otp" >
        <action
            android:id="@+id/action_otp_to_create_password"
            app:destination="@id/createPasswordFragment" />
        <action
            android:id="@+id/action_otp_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/landingFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/createPasswordFragment"
        android:name="com.lastmilebanking.app.features.onboarding.CreatePasswordFragment"
        android:label="Create Password"
        tools:layout="@layout/fragment_create_password" >
        <action
            android:id="@+id/action_password_to_personal_info"
            app:destination="@id/personalInfoFragment" />
        <action
            android:id="@+id/action_password_to_sync"
            app:destination="@id/syncProgressFragment" />
        <action
            android:id="@+id/action_password_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/landingFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/personalInfoFragment"
        android:name="com.lastmilebanking.app.features.onboarding.PersonalInfoFragment"
        android:label="Personal Info"
        tools:layout="@layout/fragment_personal_info" >
        <action
            android:id="@+id/action_personal_to_address"
            app:destination="@id/addressFragment" />
    </fragment>

    <fragment
        android:id="@+id/addressFragment"
        android:name="com.lastmilebanking.app.features.onboarding.AddressFragment"
        android:label="Address"
        tools:layout="@layout/fragment_address" >
        <action
            android:id="@+id/action_address_to_sync"
            app:destination="@id/syncProgressFragment" />
    </fragment>

    <fragment
        android:id="@+id/syncProgressFragment"
        android:name="com.lastmilebanking.app.features.onboarding.SyncProgressFragment"
        android:label="Creating Account"
        tools:layout="@layout/fragment_sync_progress" >
        <action
            android:id="@+id/action_sync_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/landingFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.lastmilebanking.app.features.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_home_to_qr"
            app:destination="@id/qrPayFragment" />
        <action
            android:id="@+id/action_home_to_bluetooth"
            app:destination="@id/bluetoothPayFragment" />
        <action
            android:id="@+id/action_home_to_sms"
            app:destination="@id/smsPayFragment" />
        <action
            android:id="@+id/action_home_to_transactionDetails"
            app:destination="@id/transactionDetailsFragment" />
        <action
            android:id="@+id/action_home_to_receivePayment"
            app:destination="@id/merchantReceivePaymentFragment" />
    </fragment>

    <fragment
        android:id="@+id/qrPayFragment"
        android:name="com.lastmilebanking.app.features.payments.QrPayFragment"
        android:label="QR Pay"
        tools:layout="@layout/fragment_qr_pay" />

    <fragment
        android:id="@+id/bluetoothPayFragment"
        android:name="com.lastmilebanking.app.features.payments.BluetoothPayFragment"
        android:label="Bluetooth Pay"
        tools:layout="@layout/fragment_bluetooth_pay" />

    <fragment
        android:id="@+id/smsPayFragment"
        android:name="com.lastmilebanking.app.features.payments.SmsPayFragment"
        android:label="SMS Pay"
        tools:layout="@layout/fragment_sms_pay" />
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.lastmilebanking.app.features.history.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" >
        <action
            android:id="@+id/action_history_to_transactionDetails"
            app:destination="@id/transactionDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/walletFragment"
        android:name="com.lastmilebanking.app.features.wallet.WalletFragment"
        android:label="Wallet"
        tools:layout="@layout/fragment_wallet" >
        <action
            android:id="@+id/action_wallet_to_addMoney"
            app:destination="@id/addMoneyFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.lastmilebanking.app.features.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profile_to_my_qr"
            app:destination="@id/myQrFragment" />
    </fragment>

    <fragment
        android:id="@+id/myQrFragment"
        android:name="com.lastmilebanking.app.features.profile.MyQrFragment"
        android:label="My QR"
        tools:layout="@layout/fragment_my_qr" />

    <fragment
        android:id="@+id/transactionDetailsFragment"
        android:name="com.lastmilebanking.app.features.history.TransactionDetailsFragment"
        android:label="Receipt"
        tools:layout="@layout/fragment_transaction_details">
        <argument
            android:name="transactionId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/addMoneyFragment"
        android:name="com.lastmilebanking.app.features.wallet.AddMoneyFragment"
        android:label="Add Money"
        tools:layout="@layout/fragment_add_money" />

    <fragment
        android:id="@+id/merchantReceivePaymentFragment"
        android:name="com.lastmilebanking.app.features.payments.MerchantReceivePaymentFragment"
        android:label="Receive Payment"
        tools:layout="@layout/fragment_merchant_receive_payment">
        <action
            android:id="@+id/action_receive_to_display"
            app:destination="@id/merchantQrDisplayFragment" />
    </fragment>

    <fragment
        android:id="@+id/merchantQrDisplayFragment"
        android:name="com.lastmilebanking.app.features.payments.MerchantQrDisplayFragment"
        android:label="Scan to Pay"
        tools:layout="@layout/fragment_merchant_qr_display">
        <argument
            android:name="canonicalPayload"
            app:argType="string" />
        <argument
            android:name="amount"
            app:argType="string" />
        <argument
            android:name="merchantName"
            app:argType="string" />
    </fragment>

</navigation>
